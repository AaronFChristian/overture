.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

.env

.DS_Store

.vscode/
.idea/

# Terraform -- state can contain resource metadata, tfvars holds a
# real IP address and email; the lock file IS committed on purpose
# (reproducible provider versions), see decisions.md D-0025.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/terraform.tfvars
terraform/tfplan

# Frontend -- has its own .gitignore too (node_modules, dist, *.local),
# duplicated at the root so a stray `git add -A` from the repo root
# never accidentally stages a multi-hundred-MB node_modules tree.
frontend/node_modules/
frontend/dist/
frontend/*.local
