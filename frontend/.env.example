# Copy to .env.local for local development. Same convention as the
# backend's .env vs .env.example (decisions.md D-0002).
#
# Points the frontend at your local FastAPI dev server. In
# production, this is baked in at build time to point at the
# deployed API instead -- see decisions.md D-0040.
VITE_API_BASE_URL=http://localhost:8000
